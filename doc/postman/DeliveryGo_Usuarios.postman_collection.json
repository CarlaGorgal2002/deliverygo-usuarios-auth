{
  "info": {
    "name": "DeliveryGo - Usuarios y Autenticacion",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "16 operaciones. Ejecutar primero el recorrido automatico; luego copiar el token de recuperacion del log local para el recorrido manual."
  },
  "item": [
    {
      "name": "Recorrido automatico",
      "item": [
        {
          "name": "API-01 | Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Pérez\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"email\", \"postman.\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Correlation ID\", function () { pm.expect(pm.response.headers.get(\"X-Correlation-Id\")).to.be.a(\"string\").and.not.empty; });",
                  "pm.test(\"Contenido esperado\", function () { pm.expect(pm.response.json().rol).to.eql(\"CLIENTE\"); pm.expect(pm.response.json().estado).to.eql(\"ACTIVO\"); pm.expect(pm.response.json()).not.to.have.property(\"passwordHash\"); });",
                  "if (pm.response.code < 300) pm.environment.set(\"usuarioId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
