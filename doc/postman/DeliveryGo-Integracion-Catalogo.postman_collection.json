{
  "info": {
    "name": "DeliveryGo Usuarios y Catalogo - JWT real",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Tokens obtenidos por login real de Usuarios. Catalogo debe usar el mismo JWT_SECRET. No modifica productos o comercios existentes."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.variables.set('correlationId', pm.variables.replaceIn('{{$guid}}'));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Login ADMIN en Usuarios",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Correlation-Id",
            "value": "{{correlationId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = pm.variables.replaceIn('{{$guid}}');",
              "pm.collectionVariables.set('email', 'demo-' + suffix + '@deliverygo.test');",
              "pm.collectionVariables.set('emailB', 'otro-' + suffix + '@deliverygo.test');",
              "['token','adminToken','userId','userBId','addressId','addressBId','recoveryToken','pollCount'].forEach(k => pm.collectionVariables.unset(k));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "if (pm.response.code < 300) pm.collectionVariables.set('adminToken', data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Registrar CLIENTE en Usuarios",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Correlation-Id",
            "value": "{{correlationId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/v1/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Perez\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"telefono\": \"+54 11 5555 0101\",\n  \"rol\": \"ADMIN\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const data = pm.response.json();",
              "if (pm.response.code < 300) pm.collectionVariables.set('userId', data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Login CLIENTE en Usuarios",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Correlation-Id",
            "value": "{{correlationId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "if (pm.response.code < 300) pm.collectionVariables.set('token', data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Catalogo acepta JWT ADMIN de Usuarios",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Correlation-Id",
            "value": "{{correlationId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{catalogoUrl}}/api/v1/categorias",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Demo {{$guid}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const data = pm.response.json();",
              "if (pm.response.code < 300) pm.collectionVariables.set('categoriaId', data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Catalogo rechaza CLIENTE para administrar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Correlation-Id",
            "value": "{{correlationId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{catalogoUrl}}/api/v1/categorias",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"No permitida\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
              "const data = pm.response.json();"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Catalogo exige autenticacion",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Correlation-Id",
            "value": "{{correlationId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{catalogoUrl}}/api/v1/categorias",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"No permitida\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "const data = pm.response.json();"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Borrar categoria creada para la prueba",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-Correlation-Id",
            "value": "{{correlationId}}"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{catalogoUrl}}/api/v1/categorias/{{categoriaId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Sin cuerpo\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
            ]
          }
        }
      ]
    }
  ]
}
