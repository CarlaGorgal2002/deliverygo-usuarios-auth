@startuml der
skinparam dpi 120
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam linetype ortho
hide circle
title Diagrama entidad-relación de la base propia del módulo (PostgreSQL)

entity "roles" as roles {
  * id : BIGINT <<PK>>
  --
  * nombre : VARCHAR(30) <<UNIQUE>>
  descripcion : VARCHAR(120)
}

entity "usuarios" as usuarios {
  * id : BIGINT <<PK>>
  --
  * nombre : VARCHAR(80)
  * apellido : VARCHAR(80)
  * email : VARCHAR(120) <<UNIQUE>>
  * password_hash : VARCHAR(100)
  telefono : VARCHAR(30)
  * estado : VARCHAR(10)
  * fecha_alta : TIMESTAMP
  * rol_id : BIGINT <<FK>>
}

entity "direcciones" as direcciones {
  * id : BIGINT <<PK>>
  --
  * usuario_id : BIGINT <<FK>>
  * calle : VARCHAR(100)
  * numero : VARCHAR(10)
  piso : VARCHAR(10)
  departamento : VARCHAR(10)
  * ciudad : VARCHAR(80)
  * provincia : VARCHAR(80)
  * codigo_postal : VARCHAR(10)
  * predeterminada : BOOLEAN
  * activa : BOOLEAN
}

entity "tokens_recuperacion" as tokens {
  * id : BIGINT <<PK>>
  --
  * usuario_id : BIGINT <<FK>>
  * token_hash : VARCHAR(64) <<UNIQUE>>
  * creado_en : TIMESTAMP
  * expira_en : TIMESTAMP
  usado_en : TIMESTAMP
}

roles ||--o{ usuarios : "REL-02\nun rol, muchos usuarios"
usuarios ||--o{ direcciones : "REL-01\nun usuario, muchas direcciones"
usuarios ||--o{ tokens : "REL-03\nun usuario, muchos tokens"
@enduml
