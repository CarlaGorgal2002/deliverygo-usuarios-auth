@startuml SEC-05
skinparam dpi 170
title SEC-05 Administrar direcciones (CU-05)
autonumber
actor "Cliente via Portal" as Cliente
participant "JwtAuthFilter" as Sec
participant "DireccionController" as Ctrl
participant "DireccionService" as Srv
participant "UsuarioRepository" as RepU
participant "DireccionRepository" as RepD
database "BD Usuarios" as BD
Cliente -> Sec : GET, POST, PUT, DELETE o PATCH\n/api/v1/users/{id}/addresses (API-05 a API-09) + Bearer
Sec -> Sec : validar sesion [RN-09] e identidad [RN-05]
Sec -> Ctrl : solicitud autenticada
alt Alta (API-06)
  Ctrl -> Ctrl : validar formato [RN-01]
  Ctrl -> Srv : crearDireccion(usuarioId, DTO-06) (SRV-05)
  Srv -> RepU : findById(usuarioId) (REP-02) [RN-04]
  opt primera direccion o marcada como predeterminada [RN-07]
    Srv -> RepD : findByUsuarioIdAndPredeterminadaTrue(usuarioId) (REP-08)
    Srv -> RepD : save(anterior sin predeterminada) (REP-07)
  end
  Srv -> RepD : save(direccion) (REP-07)
  note right : una sola transaccion [DM-10]
  Ctrl --> Cliente : 201 DireccionResponse (DTO-07)
else Modificacion (API-07)
  Ctrl -> Ctrl : validar formato [RN-01]
  Ctrl -> Srv : modificarDireccion(usuarioId, direccionId, DTO-09) (SRV-06)
  Srv -> RepU : findById(usuarioId) (REP-02) [RN-04]
  Srv -> RepD : findByIdAndUsuarioIdAndActivaTrue(id, usuarioId) (REP-06) [RN-05]
  Srv -> RepD : save(direccion) (REP-07)
  Ctrl --> Cliente : 200 DireccionResponse (DTO-07)
else Baja (API-08)
  Ctrl -> Srv : eliminarDireccion(usuarioId, direccionId) (SRV-07)
  Srv -> RepU : findById(usuarioId) (REP-02) [RN-04]
  Srv -> RepD : findByIdAndUsuarioIdAndActivaTrue(id, usuarioId) (REP-06) [RN-05]
  Srv -> Srv : activa = false, predeterminada = false [DM-04]
  Srv -> RepD : save(direccion) (REP-07)
  Ctrl --> Cliente : 204 sin cuerpo
else Seleccion de predeterminada (API-09)
  Ctrl -> Srv : seleccionarDireccionPredeterminada(usuarioId, direccionId) (SRV-08)
  Srv -> RepU : findById(usuarioId) (REP-02) [RN-04]
  Srv -> RepD : findByIdAndUsuarioIdAndActivaTrue(id, usuarioId) (REP-06) [RN-05]
  Srv -> RepD : findByUsuarioIdAndPredeterminadaTrue(usuarioId) (REP-08)
  Srv -> RepD : save(anterior y nueva) (REP-07) [RN-07]
  note right : una sola transaccion [DM-10]
  Ctrl --> Cliente : 200 DireccionResponse (DTO-07)
else Listado (API-05)
  Ctrl -> Srv : listarDirecciones(usuarioId) (SRV-09)
  Srv -> RepU : findById(usuarioId) (REP-02) [RN-04]
  Srv -> RepD : findByUsuarioIdAndActivaTrue(usuarioId) (REP-05)
  Ctrl --> Cliente : 200 lista de DireccionResponse (DTO-07)
end
note over Cliente, BD : Errores comunes con ErrorResponse (DTO-08): 401 sesion invalida [RN-09], 403 no titular [RN-05], 422 usuario INACTIVO [RN-04], 404 direccion inexistente o ajena [RN-05], 400 datos invalidos [RN-01]
@enduml