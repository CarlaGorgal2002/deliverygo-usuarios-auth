@startuml clases
skinparam dpi 120
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam nodesep 70
skinparam ranksep 70
hide circle
title Diagrama de clases del dominio (ENT-01 a ENT-04)

class Usuario <<ENT-01>> {
  - id : Long
  - nombre : String
  - apellido : String
  - email : String {unique}
  - passwordHash : String
  - telefono : String [0..1]
  - estado : EstadoUsuario
  - fechaAlta : LocalDateTime
}

enum EstadoUsuario <<enumeration>> {
  ACTIVO
  INACTIVO
}

class Rol <<ENT-02>> {
  - id : Long
  - nombre : String {unique}
  - descripcion : String
}

class Direccion <<ENT-03>> {
  - id : Long
  - calle : String
  - numero : String
  - piso : String [0..1]
  - departamento : String [0..1]
  - ciudad : String
  - provincia : String
  - codigoPostal : String
  - predeterminada : boolean
  - activa : boolean
}

class TokenRecuperacion <<ENT-04>> {
  - id : Long
  - tokenHash : String {unique}
  - creadoEn : LocalDateTime
  - expiraEn : LocalDateTime
  - usadoEn : LocalDateTime [0..1]
}

Usuario "0..*" --> "1" Rol : rol\nREL-02
Direccion "0..*" --> "1" Usuario : usuario\nREL-01
TokenRecuperacion "0..*" --> "1" Usuario : usuario\nREL-03
Usuario --> EstadoUsuario : estado

note bottom of Direccion
  Baja lógica: activa = false (DM-04).
  A lo sumo una predeterminada activa por usuario (RN-07).
end note
note bottom of TokenRecuperacion
  Sólo se guarda el hash SHA-256 del token (DM-14).
  Un solo uso: usadoEn lo marca (RN-13).
end note
note bottom of Usuario
  Se guarda sólo passwordHash (BCrypt), nunca la contraseña (RN-03).
  Las relaciones son unidireccionales y LAZY (DM-12).
end note
@enduml
