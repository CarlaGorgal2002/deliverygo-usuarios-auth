@startuml arquitectura
skinparam dpi 135
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
title Arquitectura implementada del módulo Usuarios
skinparam componentStyle rectangle
actor "Portal Web" as Portal
component "Módulos consumidores" as Mods
package "Usuarios y Autenticación - Spring Boot" {
 [Seguridad\nJwtAuthenticationFilter\nApiKeyAuthenticationFilter\nApiRequestFilter / SecurityConfig] as Sec
 [Controllers\nAuth / Usuario / Direccion] as Ctrl
 [Services\nUsuario / Auth / Direccion\nAdministracion / Recuperacion] as Srv
 [DTO y Mapper] as Dto
 [Repositories JPA\nUsuario / Rol / Direccion\nTokenRecuperacion] as Rep
 [Domain\nUsuario / Rol / Direccion\nTokenRecuperacion] as Dom
 [NotificacionesClient\nHTTP o mock declarado] as Int
}
database "PostgreSQL 16\nBD propia" as BD
component "Notificaciones\nservicio externo" as Notif
Portal --> Sec : HTTP/JSON + Bearer JWT
Mods --> Sec : HTTP/JSON + X-Api-Key
Sec --> Ctrl
Ctrl --> Srv
Srv ..> Dto : devuelve DTO
Srv --> Rep : transacciones
Rep ..> Dom
Rep --> BD
Srv --> Int : después de persistir\nbienvenida / recuperación
Int --> Notif : INT-01 / INT-06\nHTTP en segundo plano
note bottom of BD : H2 sólo en pruebas automáticas.
@enduml
